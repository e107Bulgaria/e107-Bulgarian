<?xml version="1.0" encoding="utf-8"?>
<e107Theme name="blank" version="1.0" date="2031-05-01" compatibility="2.0" livedemo='https://e107.org'>
	<author name ="e107 Inc" email="nospam@e107.org" url="https://e107.org" />
	<summary>Примерна базова тема</summary>
	<description>Базова тема за e107</description>
	<category>generic</category>
	<compliance xhtml="1.1" css="2.1" />
	<libraries>
		<library name="bootstrap" version="3" scope="front"/>
		<library name="fontawesome" version="4"  scope="front"/>
	</libraries>
    <plugins>
		<plugin name='chatbox_menu' url='core' />
	</plugins>
	<screenshots>
		<image></image>
	</screenshots>
	<keywords>
		<word>blank</word>
		<word>empty</word>
		<word>template</word>
	</keywords>
	<layouts>
		<layout name='default' title='По подразбиране' default='true' />
		<layout name='home' title='Начална страница'>
			<custompages>FRONTPAGE</custompages>
		</layout>
		<layout name='full' title='Пълна ширина'>
			<custompages>/forum</custompages>
		</layout>
	</layouts>
	<themePrefs>
		<pref name='example'>Запазена стойност на темата 1</pref>
		<pref name='example2'>Запазена стойност на темата 2</pref>
	</themePrefs>
</e107Theme>